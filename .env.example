# DevDex — copy to .env and fill in only what you need.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real keys.

# ---------------------------------------------------------------------------
# REQUIRED — you drive the agent yourself
# ---------------------------------------------------------------------------
# The published metric is agent-side: Claude Opus picks its own queries, may read
# a page it found, then commits to ranked citations. Measuring it means running
# that loop, which is why this key is not optional and why a full arm costs
# ~$165 (~$0.28/item across 594 items).
ANTHROPIC_API_KEY=<your Anthropic API key>

# ---------------------------------------------------------------------------
# SUBMITTING YOUR OWN ENGINE (the preferred route)
# ---------------------------------------------------------------------------
# Point us at the MCP server you ship to your own users and it is mounted as-is,
# exactly like every arm in the published table. The CLI flags
# --mcp-url/--search-tool/--fetch-tool/--auth write these same values, so set
# one or the other, not both.
# DEVDEX_EXT_MCP_URL=https://mcp.yourco.com/mcp
# DEVDEX_EXT_SEARCH_TOOL=your_search
# DEVDEX_EXT_FETCH_TOOL=your_fetch          # omit if you ship no reader
# DEVDEX_EXT_AUTH=Bearer <your key>         # omit if your server is keyless

# ---------------------------------------------------------------------------
# REPRODUCING A PUBLISHED ARM — only the one you want to run
# ---------------------------------------------------------------------------
# Firecrawl Developer Index, Firecrawl Search (dev category), Firecrawl web search
FIRECRAWL_API_KEY=<Firecrawl API key>
# Exa (web_search_advanced_exa)
EXA_API_KEY=<Exa API key>
# Parallel (web_search). Usable unauthenticated, but the token raises the rate
# limit and a throttled arm measures the wrong thing.
PARALLEL_API_KEY=<Parallel API key>
# Context7 (docs track only). Free keys hit a MONTHLY account cap, not a daily
# rate limit; set C7_ANON=1 to run the keyless tier instead, which is stamped
# into every record because it is a different service tier.
CONTEXT7_API_KEY=<Context7 API key>
# C7_ANON=1
#
# Mintlify Index needs NO key. Note its endpoint caps at 1,000 requests/day per
# IP, and one track exceeds that, so a cell there takes more than one day.
